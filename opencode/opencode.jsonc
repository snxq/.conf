{
  "$schema": "https://opencode.ai/config.json",

  // ── 权限：默认询问，常用只读命令放行，危险操作直接拒绝 ──
  // 规则按顺序匹配，最后一条命中的生效；交互里选 "Allow always" 的授权会保存到项目内
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git branch *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "allow" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    // V1 会询问项目外路径，V2 默认放开；这条恢复"先询问"（嫌烦可直接删掉）
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],

  // 写文件后自动格式化（按项目探测 prettier / gofmt 等）
  "formatter": true,

  // 文件监听忽略目录，减少构建产物的无效刷新
  "watcher": { "ignore": ["dist/**", "build/**", "coverage/**", "node_modules/**"] },

  // 长会话自动压缩：近期上下文默认保留 15000 token，想多保留细节就调大
  "compaction": { "auto": true, "keep": { "tokens": 15000 } },

  // 只读代码评审子代理（模型继承当前会话，主代理可自动调用）
  "agents": {
    "reviewer": {
      "description": "只读代码评审：正确性、回归风险、缺失的测试",
      "mode": "subagent",
      "system": "你是代码评审子代理，只读不改。审查当前变更的正确性、回归风险、边界条件、安全隐患和缺失的测试。按严重程度列出发现，附文件与行号引用；没有发现问题时明确说明。不要修改任何文件。",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    }
  },

  // ── MCP 服务器（密钥外置到 .secrets/，权限 600）──
  "mcp": {
    "servers": {
      "codeup": {
        "type": "local",
        "command": ["npx", "-y", "alibabacloud-devops-mcp-server"],
        "environment": {
          "YUNXIAO_ACCESS_TOKEN": "{file:~/.config/opencode/.secrets/yunxiao-token}"
        }
      }
    }
  },

  // ── 模型服务商（V2 原生格式）──
  "providers": {
    "cliproxyapi": {
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://115.190.210.10/v1",
        "apiKey": "{file:~/.config/opencode/.secrets/cliproxyapi-api-key}"
      },
      "compatibility": { "supportsPromptCacheKey": true },
      "models": {
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "limit": { "context": 1000000, "output": 393216 },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": { "supported": true }
          }
        },
        "glm-5.3": {
          "name": "glm-5.3",
          "limit": { "context": 1000000, "output": 131072 },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": { "supported": true }
          }
        },
        "glm-5.3-flash": {
          "name": "glm-5.3-flash",
          "limit": { "context": 1000000, "output": 131072 },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "video", "pdf"],
            "output": ["text"],
            "reasoning": { "supported": true }
          }
        },
        "gpt-6-astra": {
          "name": "gpt-6-astra",
          "limit": { "context": 272000, "output": 128000 },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
            "reasoning": { "supported": true }
          }
        },
        "gpt-6.1-sol": {
          "name": "gpt-6.1-sol",
          "limit": { "context": 272000, "output": 128000 },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
            "reasoning": { "supported": true }
          }
        },
        "mimo-v2.6-pro": {
          "name": "mimo-v2.6-pro",
          "limit": { "context": 1048576, "output": 131072 },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "audio", "video"],
            "output": ["text"],
            "reasoning": { "supported": true }
          }
        }
      }
    },
    "mi": {
      "name": "Xiaomi MiMo Token Plan (China)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://token-plan-cn.xiaomimimo.com/v1",
        "apiKey": "{file:~/.config/opencode/.secrets/xiaomi-mimo-api-key}"
      },
      "compatibility": { "supportsPromptCacheKey": true },
      "models": {
        "mimo-v2.6-flash": {
          "name": "mimo-v2.6-flash",
          "limit": { "context": 1048576, "output": 131072 },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true }
          }
        },
        "mimo-v2.6-pro": {
          "name": "mimo-v2.6-pro",
          "limit": { "context": 1048576, "output": 131072 },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true }
          }
        }
      }
    }
  }
}
