{
  "$schema": "https://opencode.ai/v2/cli.json",
  "mouse": false,
  "keybinds": {
    "session.tab.previous": "<leader>h",
    "session.tab.next": "<leader>l",
    "session.parent": "<leader>k",
    "session.child.first": "<leader>j",
    "variant.cycle": "<leader>v",
    "session.page.down": "ctrl+v",
    "session.page.up": "alt+v",
    "session.line.down": "ctrl+n",
    "session.line.up": "ctrl+p",
    "command.palette.show": "<leader>p",
    "prompt.paste": "ctrl+y"
  }
}
